# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Site Config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://wagepilot.com

# ─── Google Analytics 4 ──────────────────────────────────────────────────────
# Get from: https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Google AdSense ───────────────────────────────────────────────────────────
# Get from: https://adsense.google.com → Account → Get Started
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXX

# ─── Google Search Console ────────────────────────────────────────────────────
# Get from: https://search.google.com/search-console → Settings → Ownership verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# ─── Microsoft Clarity ────────────────────────────────────────────────────────
# Get from: https://clarity.microsoft.com → New Project → Get Tracking Code
NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-id
